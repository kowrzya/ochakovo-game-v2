# Скопируйте этот файл в .env и задайте свои значения.
# .env не попадает в git.

# Пароль для входа в HR-панель (/admin)
ADMIN_PASSWORD=придумайте-свой-пароль

# Ключ для подписи входа HR: любая длинная случайная строка.
# Если не задать, вход в HR-панель сбрасывается при каждом перезапуске сервера.
SESSION_SECRET=замените-на-длинную-случайную-строку
